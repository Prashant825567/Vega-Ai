# Port (Render sets this automatically)
PORT=3000

# 1. OpenCode API Key (Middle LLM: mimo-v2.6-flash-free)
OPENCODE_API_KEY=your_opencode_api_key_here

# 2. Google AI Studio API Key (For STT: gemini-2.5-flash & TTS: gemini-2.5-flash-preview-tts)
#    (Server accepts GEMINI_API_KEY, GOOGLE_API_KEY, or GOOGLE_AI_STUDIO_API_KEY)
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Models Configuration
DEFAULT_MODEL=mimo-v2.6-flash-free
GEMINI_STT_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Puck

# AI & App Branding
AI_NAME=Max v1.0
APP_NAME=Vega
VOICE_FILLER_TEXT=Ek second, abhi batata hoon.

# Optional: Secret key so only your Vega app can call this backend
# BACKEND_API_KEY=your_custom_secret_for_vega_app
