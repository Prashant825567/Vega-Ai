# Port (Render sets this automatically)
PORT=3000

# 1. OpenCode API Key (Middle LLM: deepseek-v4.1-flash-free)
OPENCODE_API_KEY=your_opencode_api_key_here

# 2. Google AI Studio API Key (For STT: gemini-3.1-flash-lite-preview & TTS: gemini-2.5-flash-native-audio-preview-12-2025)
#    (Server accepts GEMINI_API_KEY, GOOGLE_API_KEY, or GOOGLE_AI_STUDIO_API_KEY)
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Models Configuration
DEFAULT_MODEL=deepseek-v4.1-flash-free
GEMINI_STT_MODEL=gemini-3.1-flash-lite-preview
GEMINI_TTS_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
# Smooth Female Voices: Aoede (default), Kore, Leda, Zephyr, Callirrhoe, Despina, Autonoe, Erinome, Laomedeia, Pulcherrima, Sulafat, Vindemiatrix
GEMINI_TTS_VOICE=Aoede

# AI & App Branding
AI_NAME=Max v1.0
APP_NAME=Vega
VOICE_FILLER_TEXT=Ek second, abhi batata hoon.

# 3. ZentraGrid / Vega Storage (Per-User AI Chat History: ai_chats, ai_messages, /v1/files)
ZENTRAGRID_BASE_URL=https://vega-storage.onrender.com
ZENTRAGRID_API_KEY=your_zentragrid_api_key_here

# 4. NVIDIA NIM API Key (Image Generation: black-forest-labs/flux-3-image-klein, 1024x1024 default + dynamic aspect ratios)
NVIDIA_IMAGE_API_URL=https://ai.api.nvidia.com/v1/genai/black-forest-labs/flux-3-image-klein
NVIDIA_API_KEY=your_nvidia_nim_api_key_here

# 5. Cloudflare Worker (Image Editing: @cf/black-forest-labs/flux-2-klein-4b)
IMAGE_API_URL=https://image-api.pr3095079.workers.dev
IMAGE_API_KEY=your_cloudflare_worker_api_key_here

# Optional: Secret key so only your Vega app can call this backend
# BACKEND_API_KEY=your_custom_secret_for_vega_app
