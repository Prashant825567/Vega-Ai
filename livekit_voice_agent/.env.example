# ─────────────────────────────────────────────────────────────────────────────
# Vega App — Max v1.0 Real-Time LiveKit Voice Agent (.env.example)
# Copy this file to `.env`:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# 1. LiveKit Server / LiveKit Cloud Credentials
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_AGENT_NAME=vega-max-v1

# 2. Google AI Studio API Key (Used for Gemini 3.1 Flash STT + Gemini 2.5 Audio TTS)
# Supports a single key or comma-separated keys for round-robin rotation
GOOGLE_API_KEY=your_google_ai_studio_api_key

# 3. STT Configuration (Gemini 3.1 Flash with Silero VAD + StreamAdapter)
GEMINI_STT_MODEL=gemini-3.1-flash-lite-preview
GEMINI_STT_FALLBACK_MODEL=gemini-3-flash-preview
STT_LANGUAGE=hi-IN

# 4. LLM Configuration (MiMo 2.6 Flash — OpenCode or Standard OpenAI-Compatible API)
# For OpenCode Zen/Inference (Free MiMo 2.6 Flash):
#   MIMO_BASE_URL=https://opencode.ai/inference/v1
#   MIMO_API_KEY=public
# For any standard OpenAI-compatible MiMo endpoint, set MIMO_BASE_URL and MIMO_API_KEY accordingly.
MIMO_BASE_URL=https://opencode.ai/inference/v1
MIMO_API_KEY=public
MIMO_MODEL=mimo-v2.6-flash-free
MIMO_MAX_TOKENS=180
MIMO_TEMPERATURE=0.6
MAX_HISTORY_TURNS=6

# 5. TTS Configuration (Gemini 2.5 Native Audio Streaming Model)
# Supports:
#   - `models/gemini-2.5-flash-native-audio-preview-12-2025` (BidiGenerateContent WebSocket streaming, no 10/day cap)
#   - `gemini-2.5-flash-preview-tts` (LiveKit Google GeminiTTS plugin)
GEMINI_TTS_MODEL=models/gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_TTS_VOICE=Aoede
TTS_SAMPLE_RATE=24000

# 6. Silero VAD, Turn Detection & Interruption (Barge-In) Settings
VAD_MIN_SPEECH_DURATION=0.05
VAD_MIN_SILENCE_DURATION=0.35
VAD_ACTIVATION_THRESHOLD=0.50
MIN_ENDPOINTING_DELAY=0.35
MAX_ENDPOINTING_DELAY=1.50
MIN_INTERRUPTION_DURATION=0.25
ALLOW_INTERRUPTIONS=true

# 7. FastAPI Token & Health Server Settings
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
