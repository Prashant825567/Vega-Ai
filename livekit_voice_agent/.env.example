# ─────────────────────────────────────────────────────────────────────────────
# Vega App — MAX v1 Real-Time Voice Agent (Pipecat + SmallWebRTC)
# Copy this file to `.env`:
#   copy .env.example .env   (Windows CMD)
#   cp .env.example .env     (Linux / macOS)
# ─────────────────────────────────────────────────────────────────────────────

# 1. Server & Session Security Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
SESSION_SECRET=replace_with_random_32_byte_hex_secret
SESSION_TTL_MINUTES=60

# 2. SmallWebRTC STUN / TURN ICE Servers (Required for public internet / mobile NAT traversal)
STUN_SERVER_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# 3. Existing STT & TTS API Key (Google AI Studio / Gemini API Key)
# Supports a single key or comma-separated keys for round-robin rotation
GOOGLE_API_KEY=your_existing_google_api_key_here

# 4. Existing STT Configuration (Gemini 3.1 Flash — VAD-Segmented WAV)
GEMINI_STT_MODEL=gemini-3.1-flash-lite-preview
GEMINI_STT_FALLBACK_MODEL=gemini-3-flash-preview
STT_LANGUAGE=hi-IN

# 5. Existing LLM Configuration (MiMo v2.6 Flash API)
MIMO_BASE_URL=https://opencode.ai/inference/v1
MIMO_API_KEY=public
MIMO_MODEL=mimo-v2.6-flash-free
MIMO_MAX_TOKENS=180
MIMO_TEMPERATURE=0.6
MAX_HISTORY_TURNS=6

# 6. Existing TTS Configuration (Gemini 2.5 Native Audio Streaming Model)
GEMINI_TTS_MODEL=models/gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_TTS_VOICE=Aoede
TTS_SAMPLE_RATE=24000

# 7. Silero VAD, Turn Detection & Interruption (Barge-In) Settings
VAD_MIN_SPEECH_DURATION=0.05
VAD_MIN_SILENCE_DURATION=0.35
VAD_ACTIVATION_THRESHOLD=0.50
VAD_MIN_VOLUME=0.60
ALLOW_INTERRUPTIONS=true
